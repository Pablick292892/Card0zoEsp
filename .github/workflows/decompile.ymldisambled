name: Decompile to C++

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  decompile:
    runs-on: macos-14
    steps:
    - name: Checkout repository
      uses: actions/checkout@v4

    - name: Install RetDec
      run: |
        brew install retdec

    - name: Decompile Chunk
      run: |
        # Вырезаем кусок файла с 0x4100 по 0x5000
        # 0x4100 = 16640 в десятичной
        # 0x5000 = 20480 в десятичной
        # Берем 3840 байт
        dd if=libloader of=chunk.bin bs=1 skip=16640 count=3840
        
        # Декомпилируем этот кусок в C++
        retdec-decompiler --output decompiled_chunk.c chunk.bin || echo "Failed"

    - name: Upload
      uses: actions/upload-artifact@v4
      with:
        name: decompiled-cpp
        path: decompiled_chunk.c
